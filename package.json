{
  "name": "@archdevil/pi-effect-evolve",
  "version": "0.2.0",
  "description": "A lightweight Procedural Memory & Skill Cache layer for pi coding agent with semantic recall, conservative auto-crystallization, and syntax-verified repair.",
  "type": "module",
  "license": "MIT",
  "author": "ArchdevilForge",
  "keywords": [
    "pi-package",
    "effect",
    "genericagent",
    "hermes",
    "self-evolving",
    "memory"
  ],
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/src/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "benchmark": "npm run build && node --test dist/test/benchmark.test.js",
    "deep-benchmark": "npm run build && node --test dist/test/deep_benchmark.test.js",
    "extreme-benchmark": "npm run build && node --test dist/test/extreme_benchmark.test.js",
    "benchmark:smoke": "npm run build && node dist/benchmark/runner.js --smoke",
    "benchmark:ab": "npm run build && node dist/benchmark/runner.js --mode=ab",
    "benchmark:schema-tax": "npm run build && node dist/benchmark/schema-tax.js",
    "benchmark:verify-gold": "npm run build && node dist/benchmark/verify-gold.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "26.0.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
