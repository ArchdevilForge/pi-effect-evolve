# Pi Effect Evolve - env template (commit this, never commit .env)
# ponytail: allowlist-gated, conservative crystallize
# --- LLM (reuse pi's provider, or override) ---
# PI_EFFECT_MODEL=opencode-go/muse-spark-1.2-contributor
# PI_EFFECT_REASONING=xhigh

# Comma-separated allowlist, default = * (allow all hosts)
PI_EFFECT_ALLOW_HOSTS=*
# Network switch: 1 = enable (default), 0 = disable all networked web_real tools
PI_EFFECT_ALLOW_NETWORK=1
# Require human confirm before any Crystallize write
PI_EFFECT_REQUIRE_CONFIRM=1
# Log file for audit (JSONL)
PI_EFFECT_AUDIT_LOG=.pi/evolve-audit.jsonl

# --- Evolution tuning ---
# conservative | auto | gepa
PI_EFFECT_EVOLVE_MODE=conservative
# max skill size KB (Hermes gate)
PI_EFFECT_SKILL_MAX_KB=15
